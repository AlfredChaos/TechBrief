# TechBrief Secrets Template
# Copy this file to secrets.yaml and fill in the values before deploying.
# NEVER commit secrets.yaml to version control.
apiVersion: v1
kind: Secret
metadata:
  name: techbrief-secrets
  namespace: techbrief
  labels:
    app.kubernetes.io/name: techbrief
type: Opaque
stringData:
  DJANGO_SECRET_KEY: "CHANGE-ME-random-secret-key-64-chars"
  DATABASE_URL: "postgresql://techbrief:CHANGE-ME@postgres-host:5432/techbrief"
  REDIS_URL: "redis://redis-host:6379/0"
  CELERY_BROKER_URL: "redis://redis-host:6379/1"
  INITIAL_ADMIN_USERNAME: "admin"
  INITIAL_ADMIN_EMAIL: "admin@example.com"
  INITIAL_ADMIN_PASSWORD: "CHANGE-ME-NOW"
  COS_SECRET_ID: ""
  COS_SECRET_KEY: ""
  COS_BUCKET: ""
  COS_REGION: ""
  COS_DOMAIN: ""
  RESEND_API_KEY: ""
  EMAIL_FROM_ADDRESS: "digest@techbrief.app"
  WECHAT_API_BASE_URL: "https://api.weixin.qq.com"
  WECHAT_ACCESS_TOKEN: ""
  LLM_API_KEY: ""
  LLM_API_BASE_URL: "https://api.openai.com/v1"
  LLM_MODEL: "gpt-4o"
  ASR_API_KEY: ""
  ASR_API_BASE_URL: "https://api.openai.com/v1"
  GA4_MEASUREMENT_ID: ""
