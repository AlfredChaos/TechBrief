APP_ENV=local
TECHBRIEF_SERVICE=web
DJANGO_SETTINGS_MODULE=techbrief.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
PUBLIC_BASE_URL=http://127.0.0.1:8010
ADMIN_BASE_URL=http://127.0.0.1:8010

DATABASE_URL=postgresql://techbrief:techbrief@127.0.0.1:5432/techbrief
DATABASE_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/1
CELERY_TIMEZONE=UTC

COS_ENABLED=0
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_KEY_PREFIX=techbrief/local

EMAIL_DELIVERY_ADAPTER=mock
EMAIL_FROM_ADDRESS=digest@example.com
RESEND_API_KEY=

WECHAT_DRAFT_ADAPTER=mock
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_ACCESS_TOKEN=

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-now

LOG_JSON=0
